{
  "name": "ot-under-attack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "lint": "eslint frontend supabase shared && npm run lint:css",
    "lint:css": "stylelint \"frontend/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --workspace frontend run test",
    "preview": "npm --workspace frontend run preview"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.5.3",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.18.2"
  }
}
